{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "type": "object",
      "description": "Stores user account information.",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "displayName", "createdAt"]
    },
    "Course": {
      "title": "Course",
      "type": "object",
      "description": "Represents a full course structure.",
      "properties": {
        "courseId": { "type": "string" },
        "courseTitle": { "type": "string" },
        "courseDescription": { "type": "string" },
        "units": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/Unit" }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["courseId", "courseTitle", "units", "createdAt", "ownerId"]
    },
    "Unit": {
      "title": "Unit",
      "type": "object",
      "properties": {
        "unitId": { "type": "string" },
        "unitTitle": { "type": "string" },
        "unitDescription": { "type": "string" },
        "topics": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/Topic" }
        }
      },
      "required": ["unitId", "unitTitle", "topics"]
    },
    "Topic": {
      "title": "Topic",
      "type": "object",
      "properties": {
        "topicId": { "type": "string" },
        "topicTitle": { "type": "string" },
        "topicDescription": { "type": "string" },
        "mcqs": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/MCQ" }
        }
      },
      "required": ["topicId", "topicTitle", "mcqs"]
    },
    "MCQ": {
      "title": "MCQ",
      "type": "object",
      "properties": {
        "questionId": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correct": { "type": "string" },
        "explanation": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "points": { "type": "number" }
      },
      "required": ["questionId", "question", "options", "correct"]
    },
    "CourseProgress": {
      "title": "CourseProgress",
      "type": "object",
      "description": "Tracks a user's progress in a specific course.",
      "properties": {
        "courseId": { "type": "string" },
        "completedTopics": { "type": "array", "items": { "type": "string" } },
        "unitProgress": {
          "type": "object",
          "additionalProperties": { "$ref": "#/backend/entities/UnitProgress" }
        },
        "totalXP": { "type": "number" },
        "quizHistory": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/QuizResult" }
        }
      },
      "required": ["courseId", "completedTopics", "unitProgress", "totalXP", "quizHistory"]
    },
    "UnitProgress": {
      "title": "UnitProgress",
      "type": "object",
      "properties": {
        "completionPercentage": { "type": "number" }
      },
      "required": ["completionPercentage"]
    },
    "QuizResult": {
      "title": "QuizResult",
      "type": "object",
      "properties": {
        "topicId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "percentage": { "type": "number" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["topicId", "score", "total", "percentage", "completedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserAccount" },
      "description": "Stores public profile information for a user."
    },
    "/courses/{courseId}": {
      "schema": { "$ref": "#/backend/entities/Course" },
      "description": "Stores the course structure and content."
    },
    "/users/{userId}/progress/{courseId}": {
      "schema": { "$ref": "#/backend/entities/CourseProgress" },
      "description": "Stores a user's progress for a specific course."
    }
  }
}
