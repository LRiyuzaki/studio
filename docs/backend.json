{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user in the system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        }
      },
      "required": ["uid", "email"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "A quiz document containing questions and units.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ownerId": {
          "type": "string"
        }
      },
      "required": ["id", "name", "ownerId"]
    },
    "QuizProgress": {
      "title": "Quiz Progress",
      "description": "Stores a user's progress for a specific quiz, including gamification elements.",
      "type": "object",
      "properties": {
        "answers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "completion": {
          "type": "number"
        },
        "accuracy": {
          "type": "number"
        },
        "xp": {
            "type": "number",
            "description": "Experience points earned by the user."
        },
        "streak": {
            "type": "number",
            "description": "Current correct answer streak."
        },
        "averageResponseTime": {
            "type": "number",
            "description": "Average time to answer a question in seconds."
        },
        "badges": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Badges unlocked by the user."
        }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores public profile information for each user."
    },
    "/users/{userId}/quizzes/{quizId}": {
      "schema": { "$ref": "#/entities/Quiz" },
      "description": "Stores the quizzes created by a user."
    },
    "/users/{userId}/progress/{quizId}": {
      "schema": { "$ref": "#/entities/QuizProgress" },
      "description": "Stores user progress for each quiz they have taken."
    }
  }
}
