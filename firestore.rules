
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users can read and create their own profile.
    // They cannot update or delete it, or see others' profiles.
    match /users/{userId} {
      allow read, create: if isOwner(userId);
    }

    // Courses can be read by any authenticated user if they are the owner.
    // Only the owner can create, update, or delete their courses.
    match /courses/{courseId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create, update, delete: if isOwner(request.resource.data.ownerId);
    }
    
    // A user has full access to their own progress sub-collection.
    // This ensures a user's progress is private and secure.
    match /users/{userId}/progress/{courseId} {
      allow read, write, delete: if isOwner(userId);
    }
  }
}
