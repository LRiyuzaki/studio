
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read their own profile, and create it.
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
    }

    // Courses can be read by any authenticated user if they are the owner.
    // Only owners can create, update, or delete their courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == request.resource.data.ownerId;
    }

    // Users can only access their own progress documents.
    match /users/{userId}/progress/{courseId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
