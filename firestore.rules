
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own progress and user documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow any authenticated user to read course content.
    match /courses/{courseId} {
      allow get, list: if request.auth != null;
      // Only the owner can create, update, or delete a course.
      allow create, update, delete: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
