rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rule for user profile documents
    match /users/{userId} {
      // A user can create their own profile upon sign-up and read it.
      allow read, create: if request.auth != null && request.auth.uid == userId;
      
      // Rule for the 'progress' sub-collection within each user document
      match /progress/{courseId} {
        // A user can read, write, create, and delete their own progress documents.
        allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Rule for the top-level 'courses' collection
    match /courses/{courseId} {
      // Any authenticated user can read any course.
      // Write access is restricted to the course owner.
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }
  }
}
