/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and course progress,
 * and owner-based authorization for courses.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. Only the user can modify their own profile.
 * - /courses/{courseId}: Stores course data. Only the course owner can modify course content. Public read access is allowed.
 * - /users/{userId}/progress/{courseId}: Stores a user's course progress. Only the user can modify their own progress.
 *
 * Key Security Decisions:
 * - User listing is disabled to protect user privacy.
 * - Public read access is enabled for courses to allow open discovery and learning.
 *
 * Denormalization for Authorization:
 * - Courses store the `ownerId` to allow simple ownership checks.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @allow (get) Any user can read profile data.
     * @allow (update) User with ID 'user123' can update their own profile.
     * @allow (delete) User with ID 'user123' can delete their own profile.
     * @deny (create) User with ID 'user123' cannot create profile for 'user456'.
     * @deny (update) User with ID 'user123' cannot update profile for 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if true;
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to course data.
     * @path /courses/{courseId}
     * @allow (get) Any user can read course data.
     * @allow (list) Any user can list courses.
     * @allow (create) User with ID 'user123' can create a new course with ownerId 'user123'.
     * @allow (update) User with ID 'user123' can update course with ownerId 'user123'.
     * @allow (delete) User with ID 'user123' can delete course with ownerId 'user123'.
     * @deny (create) User with ID 'user123' cannot create a course with ownerId 'user456'.
     * @deny (update) User with ID 'user123' cannot update course with ownerId 'user456'.
     * @principle Enforces document ownership for writes, public read access.
     */
    match /courses/{courseId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      function isExistingOwner(ownerId) {
        return isOwner(ownerId) && resource != null;
      }

      allow get: if true;
      allow list: if true;

      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to user course progress data.
     * @path /users/{userId}/progress/{courseId}
     * @allow (create) User with ID 'user123' can create progress data for themselves.
     * @allow (get) User with ID 'user123' can read their own progress data.
     * @allow (update) User with ID 'user123' can update their own progress data.
     * @allow (delete) User with ID 'user123' can delete their own progress data.
     * @deny (create) User with ID 'user123' cannot create progress data for 'user456'.
     * @deny (update) User with ID 'user123' cannot update progress data for 'user456'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/progress/{courseId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}