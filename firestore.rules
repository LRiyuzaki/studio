/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and course progress,
 * while also allowing public read access to courses.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information. Only the user can read/write their own profile.
 * - /courses/{courseId}: Stores course data. Courses are publicly readable, but only the owner can modify them.
 * - /users/{userId}/progress/{courseId}: Stores course progress for a user. Only the user can read/write their own progress.
 *
 * Key Security Decisions:
 * - Users can only access their own profile and course progress data.
 * - Courses are publicly readable to allow discovery, but only the course owner can create, update, or delete a course.
 * - Listing of user documents is disallowed.
 *
 * Denormalization for Authorization:
 * - Courses store the `ownerId` directly on the document to enable ownership checks without additional reads.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *    request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' can read their profile.
     *    request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update their profile.
     *    request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' can delete their profile.
     *    request.auth.uid == 'user123'
     * @deny (get) User with ID 'user456' cannot read the profile of user 'user123'.
     *    request.auth.uid != 'user123'
     * @principle Enforces document ownership for all operations on the user profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to course data.
     * @path /courses/{courseId}
     * @allow (get) Any user can read any course.
     *    true
     * @allow (list) Any user can list courses.
     *    true
     * @allow (create) User with ID 'user123' can create a course with ownerId 'user123'.
     *    request.auth.uid == 'user123' && request.resource.data.ownerId == 'user123'
     * @allow (update) User with ID 'user123' can update a course they own.
     *    request.auth.uid == 'user123' && resource.data.ownerId == 'user123'
     * @allow (delete) User with ID 'user123' can delete a course they own.
     *    request.auth.uid == 'user123' && resource.data.ownerId == 'user123'
     * @deny (create) User with ID 'user456' cannot create a course with ownerId 'user123'.
     *    request.auth.uid != request.resource.data.ownerId
     * @deny (update) User with ID 'user456' cannot update a course owned by 'user123'.
     *    request.auth.uid != resource.data.ownerId
     * @principle Allows public read access to courses, but restricts write access to the course owner.
     */
    match /courses/{courseId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Controls access to user course progress data.
     * @path /users/{userId}/progress/{courseId}
     * @allow (create) User with ID 'user123' can create their course progress for a specific course.
     *    request.auth.uid == 'user123'
     * @allow (get) User with ID 'user123' can read their course progress.
     *    request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update their course progress.
     *    request.auth.uid == 'user123'
     * @allow (delete) User with ID 'user123' can delete their course progress.
     *    request.auth.uid == 'user123'
     * @deny (get) User with ID 'user456' cannot read the course progress of user 'user123'.
     *    request.auth.uid != 'user123'
     * @principle Enforces document ownership for all operations on the course progress.
     */
    match /users/{userId}/progress/{courseId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isSignedIn() && isOwner(userId) && resource != null;
  }
}